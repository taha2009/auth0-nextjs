# Auth0 Application Settings
# Create a Regular Web Application in your Auth0 dashboard:
# https://manage.auth0.com/ → Applications → Create Application
#
# Set the following in your Auth0 app settings:
#   Allowed Callback URLs:  http://localhost:3000/api/auth/callback
#   Allowed Logout URLs:    http://localhost:3000
#   Allowed Web Origins:    http://localhost:3000

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# API audience — the identifier of your Auth0 API resource server.
# If you're only doing user login (no external API), leave this empty.
# With an audience set, Auth0 issues a JWT access token (verifiable via JWKS).
AUTH0_AUDIENCE=https://your-api.example.com

# OAuth scopes to request
AUTH0_SCOPE=openid profile email

# Your app's base URL — no trailing slash
APP_BASE_URL=http://localhost:3000

# Secret used to sign session JWTs — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secret-here
